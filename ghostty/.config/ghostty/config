# ==============================================================================
# Ghostty Terminal Configuration
# Location: ~/.config/ghostty/config
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Font & Typography
# ------------------------------------------------------------------------------
font-family = "Iosevka Custom"
font-size = 15

# Subpixel / Retina display font smoothing (macOS specific)
font-thicken = true

# ------------------------------------------------------------------------------
# 2. Colors & Theme
# Matches custom dark slate palette (#151F2D background, #BEBEBC foreground)
# ------------------------------------------------------------------------------
background = 151f2d
foreground = bebebc

# Cursor colors
cursor-color = bebebc
cursor-text = 151f2d

# Selection highlight colors
selection-background = 223044
selection-foreground = bebebc

# ------------------------------------------------------------------------------
# 3. Window & Decoration
# ------------------------------------------------------------------------------
# Match custom UI padding
window-padding-x = 10
window-padding-y = 10

# Clean borderless window
window-decoration = false

# macOS specific windowing & Meta key behavior
macos-titlebar-style = hidden
macos-option-as-alt = true

# ------------------------------------------------------------------------------
# 4. Cursor & Mouse Mechanics
# ------------------------------------------------------------------------------
cursor-style = block
cursor-style-blink = true

# Automatically conceal mouse cursor during typing
mouse-hide-while-typing = true

# ------------------------------------------------------------------------------
# 5. System, Bell & Clipboard
# ------------------------------------------------------------------------------
clipboard-read = allow
clipboard-write = allow
copy-on-select = false

# Silence system audio bell
bell-action = none
