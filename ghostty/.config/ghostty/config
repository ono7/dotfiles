# ==============================================================================
# Ghostty Terminal Configuration
# Location: ~/.config/ghostty/config
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Font & Typography
# ------------------------------------------------------------------------------
font-family = "Iosevka Custom"
font-size = 20
font-thicken = false

# ------------------------------------------------------------------------------
# 2. Colors & Theme (custom-paper light palette)
# ------------------------------------------------------------------------------
background = #F2EFE9
foreground = #000000

# NOTE(jlima): Set to pitch black to match text_black; cursor-text matches paper bg
cursor-color = #000000
cursor-text = #F2EFE9

# NOTE(jlima): Sourced from c.visual (#D5CFC4) and text_black (#000000)
selection-background = #D5CFC4
selection-foreground = #000000

# NOTE(jlima): 1:1 mapping from vim.g.terminal_color_0 through terminal_color_15
palette = 0=#D5CFC4
palette = 1=#961C24
palette = 2=#355B3F
palette = 3=#80550B
palette = 4=#274F7D
palette = 5=#5A315C
palette = 6=#1A5C66
palette = 7=#38414D
palette = 8=#424B57
palette = 9=#A8222A
palette = 10=#2B4B34
palette = 11=#664308
palette = 12=#1D3B5E
palette = 13=#472649
palette = 14=#144850
palette = 15=#111417

# ------------------------------------------------------------------------------
# 3. Window & Decoration
# ------------------------------------------------------------------------------
window-padding-x = 10
window-padding-y = 10
window-decoration = false
macos-titlebar-style = hidden
macos-option-as-alt = true

# ------------------------------------------------------------------------------
# 4. Cursor & Motion
# ------------------------------------------------------------------------------
cursor-style = block
cursor-style-blink = false

mouse-hide-while-typing = true
# NOTE(jlima): Prevent Ghostty shell integration from emitting DECSCUSR sequences
shell-integration-features = no-cursor

# ------------------------------------------------------------------------------
# 5. System, Bell & Clipboard
# ------------------------------------------------------------------------------
clipboard-read = allow
clipboard-write = allow
copy-on-select = true

clipboard-read = allow
clipboard-write = allow
copy-on-select = true

# ------------------------------------------------------------------------------
# 6. Keybindings
# ------------------------------------------------------------------------------
# NOTE(jlima): Explicit clipboard access matching Linux/X11 conventions
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# ------------------------------------------------------------------------------
# 6. Keybindings
# ------------------------------------------------------------------------------
# NOTE(jlima): Unbind default terminal intercepts that clash with Emacs/Readline
keybind = ctrl+v=unbind
keybind = alt+v=unbind

# NOTE(jlima): Emacs / Readline navigation & word deletion (raw ESC byte sequences)
keybind = alt+b=text:\x1bb
keybind = alt+f=text:\x1bf
keybind = alt+d=text:\x1bd
keybind = alt+backspace=text:\x17
keybind = alt+v=text:\x1bv

# NOTE(jlima): Emacs split/window control bindings (C-x namespace)
keybind = ctrl+x>2=new_split:down
keybind = ctrl+x>3=new_split:right
keybind = ctrl+x>0=close_surface
keybind = ctrl+x>1=toggle_split_zoom
keybind = ctrl+x>o=goto_split:next
keybind = ctrl+x>ctrl+c=quit
