return {
  "nvim-lua/plenary.nvim",
  lazy = false,
  config = function()
    local function set_winbar()
      -- Disable completely for terminal buffers and excluded filetypes
      if vim.bo.buftype == "terminal" then
        vim.wo.winbar = ""
        return
      end

      local excluded_filetypes =
        { "help", "lazy", "mason", "NvimTree", "neo-tree", "toggleterm", "dashboard", "alpha", "terminal" }
      if vim.tbl_contains(excluded_filetypes, vim.bo.filetype) or vim.bo.buftype == "nofile" then
        vim.wo.winbar = ""
        return
      end

      -- Set your custom winbar layout string for normal files
      vim.wo.winbar = table.concat({
        "%<",
        "%f %h%w%m%r",
        "%{%v:lua.require('vim._core.util').term_exitcode()%}",
        "%=%{%v:lua.statusline_git_branch()%}%=",
        '%{% luaeval(\'(package.loaded["vim.ui"] and vim.api.nvim_get_current_win() == tonumber(vim.g.actual_curwin or -1) and vim.ui.progress_status()) or ""\')%}',
        "%{% &showcmdloc == 'statusline' ? '%-10.S ' : '' %}",
        "%{% exists('b:keymap_name') ? '<'..b:keymap_name..'> ' : '' %}",
        "%{% &busy > 0 ? '◐ ' : '' %}",
        '%{% luaeval(\'(package.loaded["vim.diagnostic"] and next(vim.diagnostic.count()) and vim.diagnostic.status() .. " ") or ""\') %}',
        "%{% &ruler ? ( &rulerformat == '' ? '%-14.(%l,%c%V%) %P' : &rulerformat ) : '' %}",
      })
    end

    vim.api.nvim_create_autocmd({ "BufWinEnter", "WinEnter", "FileType", "VimEnter" }, {
      callback = set_winbar,
    })
  end,
}
