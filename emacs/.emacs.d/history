;; -*- mode: emacs-lisp; lexical-binding: t; coding: utf-8-emacs-unix -*-
;; Minibuffer history file, automatically generated by ‘savehist’.

(setq savehist-minibuffer-history-variables '(read-expression-history compile-history extended-command-history file-name-history))
(setq compile-history '("make -k -j12 "))
(setq extended-command-history '("compile"))
(setq file-name-history '("~/.dotfiles/Makefile" "~/1.cpp"))
