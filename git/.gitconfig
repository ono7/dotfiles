[user]
    name = Lima, Jose
    email = 20385388+ono7@users.noreply.github.com
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEof0gR5DKko/MYjbZoDpr/TFPCuqjno8lj/Zijho5zC

[gpg]
    format = ssh

[gpg "ssh"]
# MacOS:
# ln -s "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" ~/.local/bin/op-ssh-sign
# Linux:
# ln -s "/opt/1Password/op-ssh-sign" ~/.local/bin/op-ssh-sign
    program = "op-ssh-sign"

[commit]
    gpgsign = true
    verbose = true

[tag]
    gpgsign = true
    sort = -taggerdate

[core]
    editor = nvim
    # NOTE(jlima): Removed `mergeoptions = --no-edit` (ignored by Git under [core];
    # handled explicitly in the `sync` alias below).
    pager = hunk pager
    compression = 9
    whitespace = error
    preloadindex = true
    untrackedCache = true
    excludesfile = ~/.gitignore_global

[pull]
    # ff = only         # never auto-merge on pull
    rebase = true
    # NOTE(jlima): Removed `autostash = true` here (Git only reads it from [rebase] below).

[rebase]
    autostash = true    # stash before rebase automatically
    autosquash = true
    updateRefs = true
    missingCommitCheck = warn

[fetch]
    prune = true
    prunetags = true
    fsckobjects = true

[transfer]
    fsckobjects = true

[receive]
    fsckobjects = true

[branch]
    sort = -committerdate
    autoSetupMerge = simple

[merge]
    tool = nvim
    prompt = false
    conflictstyle = zdiff3   # best conflict view

[mergetool "nvim"]
    # NOTE(jlima): Opens 3-pane LOCAL | MERGED | REMOTE layout and jumps cursor directly
    # into the center $MERGED buffer (`wincmd l`). $BASE is omitted because `zdiff3`
    # already renders the common ancestor inline inside $MERGED's conflict markers.
    cmd = nvim -d "$LOCAL" "$MERGED" "$REMOTE" -c "wincmd l"

[mergetool]
    keepBackup = false
    prompt = false

[push]
    autoSetupRemote = true
    default = current
    followTags = true

[diff]
    colorMoved = default
    algorithm = patience
    context = 4
    renames = copies
    interHunkContext = 10
    mnemonicPrefix = true

[color]
    ui = auto

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    wt = worktree
    unstage = reset HEAD --
    last = log -1 HEAD
    dv = "! args=$@; shift $#; nvim -c \"DiffviewOpen $args\""
    update-hooks = "!cp -R ~/.git_templates/hooks/. .git/hooks/ && chmod +x .git/hooks/*"
    whatadded = log --diff-filter=A
    amend = commit -a --amend --no-edit
    # NOTE(jlima): Fetches latest remote develop and merges into the current feature branch
    # without switching branches or opening nvim for the merge commit message.
    # sync, wont work with other branch names.. so we are skipping it for now
    # sync = "!git fetch origin develop && git merge origin/develop --no-edit"

[log]
    follow = true

[interactive]
    singleKey = true

[status]
    branch = true
    showStash = true
    showUntrackedFiles = all
    submoduleSummary = true

[rerere]
    # NOTE(jlima): Caches resolved merge/rebase conflicts in .git/rr-cache/
    # so repeated syncs against develop reuse prior conflict fixes automatically.
    enabled = true

[init]
    defaultBranch = main

[pager]
    diff = hunk pager
    show = hunk pager
    log = hunk log
