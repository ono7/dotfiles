[user]
  name = Lima, Jose
  email = 20385388+ono7@users.noreply.github.com 
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEof0gR5DKko/MYjbZoDpr/TFPCuqjno8lj/Zijho5zC
[gpg]
  format = ssh


[gpg "ssh"]
# MacOS
# ln -s "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" ~/.local/bin/op-ssh-sign
# Linux:
# ln -s "/opt/1Password/op-ssh-sign" ~/.local/bin/op-ssh-sign
  program = "op-ssh-sign"

[commit]
  gpgsign = true
  verbose = true

[tag]
    gpgsign = true
    sort = -taggerdate

[core]
    editor = nvim
    mergeoptions = --no-edit
    pager = delta
    compression = 9
    whitespace = error
    preloadindex = true
    untrackedCache = true
    excludesfile = ~/.gitignore_global

[pull]
  # ff = only         # never auto-merge on pull
  rebase = true
  autostash = true  # stash before rebase automatically

[rebase]
  autostash = true
  autosquash = true
  updateRefs = true
  missingCommitCheck = warn

[fetch]
    prune = true
    prunetags = true
    fsckobjects = true

[transfer]
    fsckobjects = true

[receive]
    fsckobjects = true

[branch]
    sort = -committerdate

[merge]
  tool = nvim
    prompt = false
    conflictstyle = zdiff3   # best conflict view

[mergetool "vimdiff"]
    cmd = vim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[mergetool]
    keepBackup = false
  prompt = false

[push]
  autoSetupRemote = true
    default = current
    followTags = true

[diff]
    colorMoved = default
    algorithm = patience
    context = 4
    renames = copies
    interHunkContext = 10
    mnemonicPrefix = true

[color]
    ui = auto

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    wt = worktree
    unstage = reset HEAD --
    last = log -1 HEAD
    dv = "! args=$@; shift $#; nvim -c \"DiffviewOpen $args\""
    update-hooks = "!cp -R ~/.git_templates/hooks/. .git/hooks/ && chmod +x .git/hooks/*"
    whatadded = log --diff-filter=A
  amend = commit -a --amend --no-edit

[log]
    follow = true

[interactive]
    diffFilter = delta --color-only
    singleKey = true

[status]
    branch = true
    showStash = true
    showUntrackedFiles = all
    submoduleSummary = true

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = none

    # Prevent wrapping inside side-by-side view
    wrap-max-lines = 0

    # Line foregrounds: red/green text without background fills
    minus-style = red
    plus-style = green
    zero-style = normal

    # Changed tokens: black text on desaturated gold/yellow background
    minus-emph-style = black "#e5c07b"
    plus-emph-style = black "#e5c07b"

    # Context on modified lines stays red/green instead of inheriting background fills
    minus-non-emph-style = red
    plus-non-emph-style = green

    # Blank line padding hygiene
    minus-empty-line-marker-style = normal
    plus-empty-line-marker-style = normal

    # Margin indexing
    line-numbers-left-style = brightblack
    line-numbers-right-style = brightblack
    line-numbers-zero-style = brightblack
    line-numbers-minus-style = red
    line-numbers-plus-style = green
[rerere]
  enabled = false
[init]
  defaultBranch = main
[mergetool "nvim"]
    cmd = nvim -d "$LOCAL" "$MERGED" "$REMOTE"
