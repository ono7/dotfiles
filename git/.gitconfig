[user]
    name = Lima, Jose
    email = 20385388+ono7@users.noreply.github.com
    signingkey = 850FAC73

[gpg]
    program = gpg

[commit]
    gpgsign = true
  verbose = true

[tag]
    gpgsign = true
    sort = -taggerdate

[core]
    editor = nvim
    mergeoptions = --no-edit
    pager = delta
    compression = 9
    whitespace = error
    preloadindex = true
    untrackedCache = true
    excludesfile = ~/.gitignore_global

[pull]
  # ff = only         # never auto-merge on pull
  rebase = true
  autostash = true  # stash before rebase automatically

[rebase]
  autostash = true
  autosquash = true
  updateRefs = true
  missingCommitCheck = warn

[fetch]
    prune = true
    prunetags = true
    fsckobjects = true

[transfer]
    fsckobjects = true

[receive]
    fsckobjects = true

[branch]
    sort = -committerdate

[merge]
  tool = nvim
    prompt = false
    conflictstyle = zdiff3   # best conflict view

[mergetool "vimdiff"]
    cmd = vim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[mergetool]
    keepBackup = false
  prompt = false

[push]
  autoSetupRemote = true
    default = current
    followTags = true

[diff]
    colorMoved = default
    algorithm = patience
    context = 4
    renames = copies
    interHunkContext = 10
    mnemonicPrefix = true

[color]
    ui = auto

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    wt = worktree
    unstage = reset HEAD --
    last = log -1 HEAD
    dv = "! args=$@; shift $#; nvim -c \"DiffviewOpen $args\""
    update-hooks = "!cp -R ~/.git_templates/hooks/. .git/hooks/ && chmod +x .git/hooks/*"
    whatadded = log --diff-filter=A
  amend = commit -a --amend --no-edit

[log]
    follow = true

[interactive]
    diffFilter = delta --color-only
    singleKey = true

[status]
    branch = true
    showStash = true
    showUntrackedFiles = all
    submoduleSummary = true

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = none

    # Unchanged portion of modified lines (no background fill)
    minus-style = normal
    plus-style = normal
    zero-style = normal

    # Option A: Theme-agnostic ANSI highlights on changed tokens only
    minus-emph-style = bold red reverse
    plus-emph-style = bold green reverse

    # Option B: Subtle hex backgrounds on changed tokens only (uncomment if preferred)
    # minus-emph-style = normal "#EBB1B3"
    # plus-emph-style = normal "#BED8C2"

    # Prevent background fills on empty lines inside a diff block
    minus-empty-line-marker-style = normal
    plus-empty-line-marker-style = normal

    # Keep line numbers colored so pure additions/deletions remain visible
    line-numbers-left-style = brightblack
    line-numbers-right-style = brightblack
    line-numbers-zero-style = brightblack
    line-numbers-minus-style = bold red
    line-numbers-plus-style = bold green

[rerere]
  enabled = false
[init]
  defaultBranch = main
[mergetool "nvim"]
    cmd = nvim -d "$LOCAL" "$MERGED" "$REMOTE"
