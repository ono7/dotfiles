[user]
    name = Lima, Jose
    email = 20385388+ono7@users.noreply.github.com
    signingkey = 850FAC73

[gpg]
    program = gpg

[commit]
    gpgsign = true
  verbose = true

[tag]
    gpgsign = true
    sort = -taggerdate

[core]
    editor = nvim
    mergeoptions = --no-edit
    pager = delta
    compression = 9
    whitespace = error
    preloadindex = true
    untrackedCache = true
    excludesfile = ~/.gitignore_global

[pull]
  # ff = only         # never auto-merge on pull
  rebase = true
  autostash = true  # stash before rebase automatically

[rebase]
  autostash = true
  autosquash = true
  updateRefs = true
  missingCommitCheck = warn

[fetch]
    prune = true
    prunetags = true
    fsckobjects = true

[transfer]
    fsckobjects = true

[receive]
    fsckobjects = true

[branch]
    sort = -committerdate

[merge]
  tool = nvim
    prompt = false
    conflictstyle = zdiff3   # best conflict view

[mergetool "vimdiff"]
    cmd = vim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[mergetool]
    keepBackup = false
  prompt = false

[push]
  autoSetupRemote = true
    default = current
    followTags = true

[diff]
    colorMoved = default
    algorithm = patience
    context = 4
    renames = copies
    interHunkContext = 10

[color]
    ui = auto

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    wt = worktree
    unstage = reset HEAD --
    last = log -1 HEAD
    dv = "! args=$@; shift $#; nvim -c \"DiffviewOpen $args\""
    update-hooks = "!cp -R ~/.git_templates/hooks/. .git/hooks/ && chmod +x .git/hooks/*"
    whatadded = log --diff-filter=A

[log]
    follow = true

[interactive]
    diffFilter = delta --color-only
    singleKey = true

[status]
    branch = true
    showStash = true
    showUntrackedFiles = all
    submoduleSummary = true

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    light = true
    syntax-theme = none

    # Blame palette stepped from paper BG (#F2EFE9) down to visual depth (#D5CFC4)
    blame-palette = "#F2EFE9 #EAE6DF #E2DDD4 #D8D2C7 #CDC6B9"

    # Header styling (dark ink text on paper)
    file-decoration-style = none
    file-style = bold "#000000"
    hunk-header-decoration-style = none
    hunk-header-file-style = bold "#000000"
    hunk-header-line-number-style = bold "#5C6A7B"
    hunk-header-style = file line-number syntax

    # Line numbers (matching c.line_nr and diagnostics)
    line-numbers-left-style = "#A9B3C1"
    line-numbers-right-style = "#A9B3C1"
    line-numbers-zero-style = "#A9B3C1"
    line-numbers-minus-style = bold "#961C24"
    line-numbers-plus-style = bold "#355B3F"

    # Diff backgrounds (soft tinted paper matching diff_add_bg and diff_text_bg)
    minus-style = syntax "#F7DCDA"
    minus-emph-style = syntax "#EBB1B3"
    minus-empty-line-marker-style = normal "#F7DCDA"

    plus-style = syntax "#DCE8DE"
    plus-emph-style = syntax "#BED8C2"
    plus-empty-line-marker-style = normal "#DCE8DE"

    zero-style = syntax
    whitespace-error-style = "#C4434B" reverse
    word-diff-regex = "[^[:space:]]+"

    line-numbers-left-format = "{nm:>4}│"
    line-numbers-right-format = "{np:>4}│"

    # Delta map-styles using custom-paper ink colors
    map-styles = \
        bold purple => "#5A315C", \
        bold blue => "#274F7D", \
        bold cyan => "#1A5C66", \
        bold yellow => "#80550B", \
        bold green => "#355B3F", \
        bold red => "#961C24"

[rerere]
  enabled = false
[init]
  defaultBranch = main
[mergetool "nvim"]
    cmd = nvim -d "$LOCAL" "$MERGED" "$REMOTE"
