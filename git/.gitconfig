[user]
    name = Lima, Jose
    email = 20385388+ono7@users.noreply.github.com
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEof0gR5DKko/MYjbZoDpr/TFPCuqjno8lj/Zijho5zC

[gpg]
    format = ssh

[gpg "ssh"]
# MacOS:
# ln -s "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" ~/.local/bin/op-ssh-sign
# Linux:
# ln -s "/opt/1Password/op-ssh-sign" ~/.local/bin/op-ssh-sign
    program = "op-ssh-sign"

[commit]
    gpgsign = true
	verbose = true

[tag]
    gpgsign = true
    sort = -taggerdate

[core]
    editor = nvim
    pager = hunk pager
    # NOTE(jlima): Lowered from 9 to 1 (or default) — zlib level 9 burns extra CPU on
    # pack/object writes for negligible size savings over level 1-3 on NVMe storage.
    compression = 1
    whitespace = error
    preloadindex = true
    untrackedCache = true
    excludesfile = ~/.gitignore_global

[pull]
    # ff = only         # never auto-merge on pull
    rebase = true
    # NOTE(jlima): Removed `autostash = true` here (Git only reads it from [rebase] below).

[rebase]
    autostash = true    # stash before rebase automatically
    autosquash = true
    updateRefs = true
    missingCommitCheck = warn

[fetch]
    prune = true
    prunetags = true
    fsckobjects = true

[transfer]
    fsckobjects = true

[receive]
    fsckobjects = true

[branch]
    sort = -committerdate
    autoSetupMerge = simple

[merge]
    tool = nvim
    prompt = false
    conflictstyle = zdiff3   # best conflict view

[mergetool "nvim"]
    # NOTE(jlima): Opens 3-pane LOCAL | MERGED | REMOTE layout and jumps cursor directly
    # into the center $MERGED buffer (`wincmd l`). $BASE is omitted because `zdiff3`
    # already renders the common ancestor inline inside $MERGED's conflict markers.
    cmd = nvim -d "$LOCAL" "$MERGED" "$REMOTE" -c "wincmd l"

[mergetool]
    keepBackup = false
    prompt = false

[push]
    autoSetupRemote = true
    default = current
    followTags = true

[diff]
    colorMoved = default
    # NOTE(jlima): `histogram` improves upon `patience` with faster execution and
    # cleaner diff hunks around structural blocks (braces, YAML, functions).
    algorithm = histogram
    context = 4
    renames = copies
    interHunkContext = 10
    mnemonicPrefix = true

[color]
    ui = auto

[alias]
    co = checkout
    sw = switch
    br = branch
    ci = commit
    st = status
    wt = worktree
    unstage = reset HEAD --
    last = log -1 HEAD
    dv = "! args=$@; shift $#; nvim -c \"DiffviewOpen $args\""
    update-hooks = "!cp -R ~/.git_templates/hooks/. .git/hooks/ && chmod +x .git/hooks/*"
    whatadded = log --diff-filter=A
    amend = commit -a --amend --no-edit
    # NOTE(jlima): Prints a header showing the upstream target and unpushed commit count
    # before running --no-pager log --stat so empty output isn't ambiguous.
    stat = "!sh -c 'if up=$(git rev-parse --abbrev-ref @{u} 2>/dev/null); then range=\"$up..HEAD\"; label=\"$up\"; else range=\"HEAD --not --remotes=origin\"; label=\"any origin branch\"; fi; count=$(git rev-list --count $range); echo \"Unpushed commits ($count) ahead of $label:\"; [ \"$count\" -gt 0 ] && { case \" $* \" in *\" -p \"*|*\" --patch \"*) git log $range --no-graph --stat \"$@\" ;; *) git --no-pager log $range --no-graph --stat \"$@\" ;; esac; }' --"

[log]
    follow = true

[interactive]
    singleKey = true

[status]
    branch = true
    showStash = true
    showUntrackedFiles = all
    submoduleSummary = true

[rerere]
    # NOTE(jlima): Caches resolved merge/rebase conflicts in .git/rr-cache/
    # so repeated syncs against develop reuse prior conflict fixes automatically.
    enabled = true

[init]
    defaultBranch = main
    # NOTE(jlima): Automatically copies hooks/templates on `git init` and `git clone`.
    templateDir = ~/.git_templates

[pager]
    diff = hunk pager
    show = hunk pager
    # NOTE(jlima): Disabled `hunk log` here because it overrides `git log --stat`
    # and `--oneline` formatting; using standard `less -FRX` preserves native flags.
    log = less -FRX

[help]
    # NOTE(jlima): Prompts confirmation before executing mistyped commands (e.g., `git statsu`).
    autocorrect = prompt

[column]
    # NOTE(jlima): Displays `git branch` and `git tag` output in compact terminal columns.
    ui = auto
